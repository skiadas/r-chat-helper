# Copy this file to .env in this directory and fill it in. .env is gitignored;
# never commit it. It is loaded automatically at startup (godotenv), so no
# sourcing is needed. An .env is optional: the same variables can be set in the
# environment instead, and environment values win over .env.

# Shared class API key (opencode workspace credential). Required: model calls
# fail without it. The control plane injects it as a Bearer token on every
# upstream request; students never see it.
RC_PROVIDER_KEY=

# Upstream chat base URL. Default (unset) is the opencode Go rail, billed
# against the Go subscription. The Zen pay-as-you-go rail is:
#   https://opencode.ai/zen/v1
# Note: the Go rail requires the account's "contact servers in China"
# permission enabled in the opencode console.
RC_UPSTREAM=https://opencode.ai/zen/go/v1

# Locked model id for every request. Default (unset) is LockedModelID.
# RC_MODEL=

# Other useful settings:
# RC_JWT_SECRET=      # stable session signing key for deployments
# RC_WEBFETCH_ALLOW=  # optional webfetch host allowlist, e.g. rdrr.io,tidyverse.org

# --- OIDC (SSO login) ---
# Sign-in requires these three to be set. The OIDC client above must be
# registered on the SSO with this redirect URI whitelisted.
RC_OIDC_ISSUER=https://sso.harisskiadas.com
RC_OIDC_CLIENT_ID=r-chat-helper
RC_OIDC_CLIENT_SECRET=
RC_OIDC_REDIRECT_URI=http://localhost:8080/auth/callback
RC_PUBLIC_URL=http://localhost:8080
# Dev only: allow the session cookie over plain http on localhost.
RC_COOKIE_SECURE=false

# People who get the instructor role on sign-in (comma-separated).
# RC_ADMIN_EMAILS=professor@college.edu

# Dev only: auto-sign-in as this email when clicking "Sign in", bypassing the
# SSO. Only active while OIDC is unconfigured (no client secret), so it can
# never bypass real SSO; remove it once you set up the SSO. The email must be
# enrolled as a student (or listed in RC_ADMIN_EMAILS).
# RC_DEV_EMAIL=you@college.edu