# Copy this file to .env and fill it in. .env is gitignored; never commit it.
# Load it in your shell before running the control plane:
#   set -a; source .env; set +a

# Shared class API key (opencode workspace credential). Required: model calls
# fail without it. The control plane injects it as a Bearer token on every
# upstream request; students never see it.
RC_PROVIDER_KEY=

# Upstream chat base URL. Default (unset) is the opencode Go rail, billed
# against the Go subscription. The Zen pay-as-you-go rail is:
#   https://opencode.ai/zen/v1
# Note: the Go rail requires the account's "contact servers in China"
# permission enabled in the opencode console.
RC_UPSTREAM=https://opencode.ai/zen/go/v1

# Locked model id for every request. Default (unset) is LockedModelID.
# RC_MODEL=

# Other useful settings:
# RC_JWT_SECRET=      # stable session signing key for deployments
# RC_WEBFETCH_ALLOW=  # optional webfetch host allowlist, e.g. rdrr.io,tidyverse.org