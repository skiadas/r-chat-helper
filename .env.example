# Server .env for r-chat-helper. Copy to .env next to compose.yml on the
# server and fill in real values. Never commit .env.

# Read by compose.yml (not the app).
DOMAIN=rchat-helper.harisskiadas.com
GHCR_OWNER=skiadas
IMAGE_TAG=latest
# Caddy runs as a compose profile; leave "proxy" for TLS.
COMPOSE_PROFILES=proxy

# --- app config (RC_*) ---
# Shared class API key (opencode workspace credential). Required.
RC_PROVIDER_KEY=

# Upstream chat base URL (Go rail default).
RC_UPSTREAM=https://opencode.ai/zen/go/v1

# Stable JWT signing secret for sessions (openssl rand -base64 32).
RC_JWT_SECRET=

# OIDC via the college SSO (standard OIDC; OTC handling is internal to SSO).
RC_OIDC_ISSUER=https://sso.harisskiadas.com
RC_OIDC_CLIENT_ID=r-chat-helper
RC_OIDC_CLIENT_SECRET=
RC_OIDC_REDIRECT_URI=https://rchat-helper.harisskiadas.com/auth/callback
RC_PUBLIC_URL=https://rchat-helper.harisskiadas.com

# Instructor emails (comma-separated) get the admin role on sign-in.
# RC_ADMIN_EMAILS=professor@college.edu

# Optional webfetch host allowlist (comma-separated). Empty = any host.
# RC_WEBFETCH_ALLOW=

# SQLite lives on the /data volume; RC_DB is set in the Dockerfile.
# RC_ADDR default :8080 inside the container; Caddy proxies to it.